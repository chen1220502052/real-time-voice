# Copy needed settings into the ignored .env.local. Never put real keys here.
AGENT_BACKEND=english_chat
# Use your existing provider/model. The endpoint can include /v1 or omit it.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Fill either LLM_API_KEY or the already supported DEEPSEEK_API_KEY locally.
LLM_API_KEY=

# Voice only; unnecessary when using scripts/run_text.sh.
ASR_BACKEND=nls
ASR_DEVICE=cpu
ALIYUN_NLS_APP_KEY=
# ECS deployment: explicitly select role identity, never fall back to static secrets.
# Local tests do not contact IMDS unless this mode is selected.
ALIYUN_NLS_AUTH_MODE=auto
# Set mode=ecs_ram_role on ECS, with the role bound in the Aliyun console.
ALIYUN_ECS_RAM_ROLE_NAME=
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_NLS_TOKEN=
TTS_BACKEND=piper
# Production browser bootstrap: persistent random key, never sent to browsers.
BROWSER_AUTH_ENABLED=0
BROWSER_AUTH_KEY_FILE=/var/lib/real-time-voice/browser-auth.key
BROWSER_AUTH_COOKIE_SECURE=1
# NLS trial quota is at most two concurrent recognizers; upgrade before raising.
MAX_CONCURRENT_SESSIONS=2
LOG_AUDIO_SPANS=0
# Short voice prefix + adaptive later phrases; text UI remains sentence-based.
# 0 restores sentence-based Bot output and the previous speech segmentation.
VOICE_SHORT_START_ENABLED=1
# Maximum text accumulation wait when a whole-word phrase is available.
TTS_SEGMENT_MAX_WAIT_MS=100
# Duplex-owned exact-input prefetch. LLM_SPECULATIVE is a legacy fallback only.
DUPLEX_PREFETCH_ENABLED=0
# Wait for a quiet window once; later ASR updates do not restart this timer.
DUPLEX_PREFETCH_STABLE_MS=120
DUPLEX_PREFETCH_MAX_PER_TURN=3
# Only gates speculative work; does not alter VAD/barge-in thresholds.
DUPLEX_PREFETCH_QUIET_RMS=0.008

# Bot-owned state and idempotency ledger. Use one worker per SQLite file.
BOT_STATE_DB=.local/bot-state.sqlite3
BOT_STATE_RETENTION_DAYS=7
BOT_STOP_GRACE_MS=150

# Interaction timers report facts/commands; the Bot owns their wording/policy.
BOT_IDLE_SECONDS=30
BOT_PROGRESS_DELAY_SECONDS=4
# Grace after all reply audio has been sent; never implies content was heard.
PLAYBACK_ACK_TIMEOUT_SECONDS=15
# Bound native CPU pools so VAD is not starved by concurrent local TTS.
VAD_CPU_THREADS=1
TTS_CPU_THREADS=2

# Optional chapter practice resource root; defaults to the repository's 英语/.
# Keep publisher indexes and their relative audio paths beneath this directory.
ENGLISH_RESOURCE_ROOT=

# Unit writing: install .[writing]; reuse LLM_API_KEY / DEEPSEEK_API_KEY.
# Empty model inherits LLM_MODEL, then deepseek-flash; endpoint defaults to DeepSeek.
WRITING_MODEL=
WRITING_BASE_URL=
# Optional UTF-8 JSON with verified per-chapter words and their source.
WRITING_VOCABULARY_FILE=

# Unit-aware text chat: install .[chat]; reuse the existing DeepSeek credentials.
# Empty overrides inherit LLM_MODEL / LLM_BASE_URL (or legacy OLLAMA_MODEL / OLLAMA_BASE_URL).
CHAT_MODEL=
CHAT_BASE_URL=
# Optional verified cumulative vocabulary pack (same schema as the writing module).
# If empty, reuse WRITING_VOCABULARY_FILE or the local reference word lists.
CHAT_VOCABULARY_FILE=
# Shared SQLite vocabulary/cache for chat and writing; defaults beside ACCOUNT_DB.
# Source changes refresh it on the next request, without restarting the service.
CHAT_LIBRARY_DB=
# Durable private dialogue records and reusable general replies, separate from textbook snapshots.
CHAT_DIALOGUE_DB=.local/chat-dialogue.sqlite3
# Preload the word database and fallback SDKs before accepting connections; no API call.
CHAT_WARMUP_ENABLED=1

# Per-user login (enabled by default). Disable only for isolated development/tests.
ACCOUNT_AUTH_ENABLED=1
# Persistent account credentials and revocable 7-day sessions; do not commit this file.
ACCOUNT_DB=.local/accounts.sqlite3
